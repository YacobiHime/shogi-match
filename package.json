{
  "name": "@yacobihime/shogi-match",
  "version": "0.7.0",
  "description": "Complete embeddable shogi match runtime for the web, RPGs, and visual novels.",
  "type": "module",
  "main": "./dist/shogi-match.js",
  "exports": {
    ".": "./dist/shogi-match.js"
  },
  "license": "GPL-3.0-or-later",
  "files": [
    "dist",
    "vendor",
    "third_party",
    "game.html",
    "integrations",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "npm run build",
    "build:hosting": "npm run build && node scripts/build-hosting.mjs",
    "import:opening-library": "node scripts/import-opening-library.mjs",
    "opening-editor": "vite --host 127.0.0.1 --open /opening-editor.html",
    "optimize:images": "node scripts/optimize-images.mjs",
    "deploy": "npm run build:hosting && npx firebase-tools deploy --only hosting",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "sharp": "^0.35.3",
    "tsshogi": "^2.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue": "^3.5.31",
    "vue-tsc": "^3.3.11"
  }
}
