rules_version = '2';
// 棋力テストの答えと対局の結果を、同意を得て匿名で集める(docs/skill-assessment-design.mdの7章)。
// 誰でも「作る」だけでき、読む・直す・消すはできない。項目の名前・型・大きさを決め、それ以外は断る。
// 送る側は src/core/skill-data.mjs。
service cloud.firestore {
  match /databases/{database}/documents {
    match /skillAnswers/{entry} {
      allow create: if request.resource.data.keys().hasOnly(['v', 'anon', 'kind', 'at', 'app', 'test', 'game'])
        && request.resource.data.v == 1
        && request.resource.data.anon is string
        && request.resource.data.anon.size() >= 16 && request.resource.data.anon.size() <= 32
        && request.resource.data.at is timestamp
        && request.resource.data.app is string && request.resource.data.app.size() <= 40
        && ((request.resource.data.kind == 'test'
              && request.resource.data.test is map
              && request.resource.data.test.keys().hasOnly(['answers', 'level', 'spread', 'band'])
              && request.resource.data.test.answers is list
              && request.resource.data.test.answers.size() <= 24
              && !('game' in request.resource.data))
          || (request.resource.data.kind == 'game'
              && request.resource.data.game is map
              && request.resource.data.game.keys().hasOnly(['opponent', 'outcome', 'event', 'plies', 'content'])
              && request.resource.data.game.outcome in ['win', 'loss', 'draw']
              && request.resource.data.game.event is string && request.resource.data.game.event.size() <= 12
              && !('test' in request.resource.data)));
      allow read, update, delete: if false;
    }
    // 引き継ぎコード(docs/save-transfer-design.mdの3章)。中身はコードから作った鍵で暗号にしてあり、ここでは読めない。
    // 作るのは誰でもできるが、項目・大きさ・期限(7日まで)を決める。一覧は出さない(文書の名前はコードを知る人しか分からない)。
    // 読むのは期限までの1件ずつ。消すのは受け取った人(名前を知る人)。書き換えはできない(同じ名前に上書きされない)。
    // 送る側は src/core/save-cloud.mjs。
    match /saveTransfers/{entry} {
      allow create: if entry.matches('^[0-9a-f]{40}(-[1-5])?$')
        && request.resource.data.keys().hasOnly(['v', 'part', 'parts', 'data', 'at', 'expireAt'])
        && request.resource.data.v == 1
        && request.resource.data.part is int && request.resource.data.part >= 0 && request.resource.data.part <= 5
        && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 6
        && request.resource.data.part < request.resource.data.parts
        && request.resource.data.data is string && request.resource.data.data.size() <= 700000
        && request.resource.data.at is timestamp
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(8, 'd');
      allow get: if resource.data.expireAt > request.time;
      allow delete: if true;
      allow list, update: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
